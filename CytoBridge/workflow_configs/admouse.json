{
  "dataset": {
    "name": "admouse",
    "display_name": "AD mouse brain",
    "annotation_key": "Annotation",
    "time_key": "time_point_processed",
    "obsm_key": "X_latent",
    "spatial_key": "spatial_aligned",
    "concat_spatial": true
  },
  "scientific": {
    "seed": 42,
    "alpha_express": 0.015,
    "classifier_k": 1
  },
  "steps": {
    "default": ["downstream"]
  },
  "preprocess": {
    "enabled": false,
    "note": "The released AD workflow starts from the package-processed aligned H5AD; supply it with --aligned-h5ad."
  },
  "train": {
    "config": null,
    "requires_edge_predictor": true,
    "edge_predictor_threshold": 0.69,
    "evaluate_after_training": false
  },
  "downstream": {
    "enabled": true,
    "model_format": "legacy",
    "observed": [0.0, 1.0, 2.0],
    "interpolated": [0.5, 1.5],
    "classifier_epochs": 500,
    "classifier_hidden_size": 128,
    "classifier_lr": 0.001,
    "classifier_best_metric": "bacc",
    "classifier_strict_stratification": true,
    "sde_n_samples": 5000,
    "sde_dt": 0.05,
    "split_sde_dt": 0.01,
    "split_sigma": 0.03,
    "split_growth_alpha": 1.0
  }
}
