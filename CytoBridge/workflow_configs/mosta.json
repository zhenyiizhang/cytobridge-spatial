{
  "dataset": {
    "name": "mosta",
    "display_name": "MOSTA mouse organogenesis",
    "annotation_key": "Annotation",
    "time_key": "time_point_processed",
    "obsm_key": "X_latent",
    "spatial_key": "spatial_aligned",
    "concat_spatial": true
  },
  "scientific": {
    "seed": 42,
    "alpha_express": 0.015,
    "classifier_k": 10
  },
  "steps": {
    "default": ["preprocess", "downstream"]
  },
  "preprocess": {
    "enabled": true,
    "time_key": "timepoint",
    "annotation_source": "annotation",
    "batch_indices": [3, 4, 5, 6],
    "align": {
      "n_top_genes": 2000,
      "n_pcs": 50,
      "normalization_target_sum": 10000.0,
      "expression_layer": "count",
      "counts_layer": "count",
      "raw_count_validation": "strict",
      "spatial_dim": 2,
      "auto_scale_from_centered_x_max": false,
      "center_x": true,
      "center_y": false,
      "flip_y": true,
      "scale_x": 0.01,
      "scale_y": 0.01,
      "phase1_epochs": 10000,
      "phase2_epochs": 500,
      "alpha": 5.0,
      "beta": 0.01,
      "lambda_local": 100.0,
      "lambda_ot": 1.0,
      "batch_size": 1024,
      "distance_pairs": 10000,
      "learning_rate": 0.001,
      "random_seed": 42,
      "time_mapping": {
        "E9.5": -3.0,
        "E10.5": -2.0,
        "E11.5": -1.0,
        "E12.5": 0.0,
        "E13.5": 1.0,
        "E14.5": 2.0,
        "E15.5": 3.0,
        "E16.5": 4.0
      }
    }
  },
  "train": {
    "config": "mosta_spatial_full_alpha_express_0015.yaml",
    "requires_edge_predictor": true,
    "edge_predictor_threshold": 0.45,
    "evaluate_after_training": false
  },
  "downstream": {
    "enabled": true,
    "model_format": "current",
    "observed": [0.0, 1.0, 2.0, 3.0],
    "interpolated": [0.5, 1.5, 2.5],
    "classifier_epochs": 500,
    "classifier_hidden_size": 128,
    "classifier_lr": 0.001,
    "classifier_best_metric": "bacc",
    "classifier_strict_stratification": true,
    "sde_n_samples": 5000,
    "sde_dt": 0.05,
    "split_sde_dt": 0.01,
    "split_sigma": 0.03,
    "split_growth_alpha": 1.0
  }
}
