include .readthedocs.yaml
include CITATION.cff
include LICENSE
include Makefile
include README.md
include requirements.txt

recursive-include docs *.css *.csv *.ipynb *.json *.md *.png *.py *.rst *.svg
recursive-include requirements *.txt
recursive-include CytoBridge/results/data *.csv *.csv.gz *.json *.npz *.pdf *.png
recursive-include scripts/results *.py
include scripts/execute_paper_notebooks.py
include scripts/collect_training_history_inputs.py
include scripts/collect_figure_inputs.py
include scripts/collect_full_model_compute_cost.py
include scripts/build_agist_velocity_time_cluster_breakdown.py
include scripts/compare_cytobridge_to_temporal_nichenet.py
include scripts/evaluate_and_plot_agist_w2_replicates.py
include scripts/prepare_temporal_nichenet_inputs.py
include scripts/plot_zebrafish_interval_daughter_noise_sensitivity.py
include scripts/plot_chicken_heart_alignment.py
include scripts/run_temporal_nichenet_reference.R
include scripts/run_agist_split_sde_replicates.py
include scripts/run_matched_ablation_benchmark_evaluation.py
include scripts/run_matched_ablation_matrix.py
include scripts/run_zebrafish_interval_daughter_noise_sensitivity.py
prune tests
recursive-include tests/results *.py
recursive-include CytoBridge/configs *.yaml
recursive-include CytoBridge/workflow_configs *.json
recursive-include CytoBridge/workflow_databases *.csv *.md
recursive-include configs *.yaml

prune docs/_build
prune docs/tutorials/paper_figures/outputs
prune internal
prune outputs
prune results
global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude __pycache__
